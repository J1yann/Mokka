# Copy to mokka.conf and fill in the bot token and server ID.
DISCORD_TOKEN=
MOKKA_GUILD_ID=
# Optional comma-separated server IDs. Overrides MOKKA_GUILD_ID when set.
MOKKA_GUILD_IDS=
MOKKA_EXTRACTOR=./extractor/target/release/mokka-extractor
MOKKA_IDLE_TIMEOUT=1h
MOKKA_OPUS_BITRATE_KBPS=96
# Optional HTTP proxy for YouTube search and audio.
MOKKA_MEDIA_PROXY=
# Optional writable directory for saved playback preferences.
MOKKA_STATE_DIR=mokka-state
# Prefix for text commands. Restart Mokka after changing it.
MOKKA_PREFIX=m!
